OPENAI_API_KEY=sk-proj-...

TAVILY_API_KEY=tvly-...

# ── Model Configuration ──────────────────────────────────────
PRIMARY_MODEL=gpt-4o-mini

# Optional: upgrade critic + fact-checker to a stronger model
EVALUATOR_MODEL=gpt-4o-mini

# ── Pipeline Configuration ───────────────────────────────────
# Max times Loop 1 (Evidence Gap) can retry before giving up
MAX_EVIDENCE_LOOPS=2

# Max times Loop 2 (Quality) can ask Writer to revise
MAX_REVISION_LOOPS=2

# Minimum fact-check support rate to exit Loop 1 (0.0 - 1.0)
# If < 70% of claims are supported, re-research
EVIDENCE_THRESHOLD=0.7

# Minimum critic score to exit Loop 2 (0.0 - 10.0)
# If overall score < 7.0, ask Writer to revise
QUALITY_THRESHOLD=7.0

# ── Dynamic Pricing Overrides (Optional) ────────────────────
# Set these (in USD per 1 Million tokens) if you want to override
# pricing for custom/unsupported models dynamically.
CUSTOM_MODEL_INPUT_PRICE=
CUSTOM_MODEL_OUTPUT_PRICE=
